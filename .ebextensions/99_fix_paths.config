container_commands:
  01_flatten_and_fix:
    command: |
      # If application.py is missing from the root, try to find it nested and move it up.
      if [ ! -f "/var/app/staging/application.py" ]; then
        APP_PATH=$(find /var/app/staging -maxdepth 2 -name "application.py" | head -n 1)
        if [ -n "$APP_PATH" ]; then
          DIR_NAME=$(dirname "$APP_PATH")
          echo "Found application.py inside $DIR_NAME. Flattening directory..."
          mv $DIR_NAME/* /var/app/staging/
        fi
      fi
